<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PWS2LevelLoader</AssemblyName>
    <RootNamespace>PWS2LevelLoader</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>jogal</Authors>
    <Product>PWS2 Level Loader</Product>
    <Description>Loads custom level content packs into PowerWash Simulator 2 (MelonLoader).</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Set -p:CopyToGame=false to skip copying the built DLL into the game's Mods folder. -->
    <CopyToGame Condition="'$(CopyToGame)' == ''">true</CopyToGame>
  </PropertyGroup>

  <!-- MelonLoader + interop runtime -->
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MLDir)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MLDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MLDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(MLDir)\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Generated IL2CPP proxies: .NET BCL side -->
  <ItemGroup>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Il2CppDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppSystem"><HintPath>$(Il2CppDir)\Il2CppSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppSystem.Core"><HintPath>$(Il2CppDir)\Il2CppSystem.Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Generated IL2CPP proxies: game -->
  <ItemGroup>
    <Reference Include="Il2CppFuturLab"><HintPath>$(Il2CppDir)\Il2CppFuturLab.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppFuturLab.PW2"><HintPath>$(Il2CppDir)\Il2CppFuturLab.PW2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppFuturLab.PW2.Core"><HintPath>$(Il2CppDir)\Il2CppFuturLab.PW2.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppFuturLab.PW2.GameContent"><HintPath>$(Il2CppDir)\Il2CppFuturLab.PW2.GameContent.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppFuturLab.PW2.TexturePainter"><HintPath>$(Il2CppDir)\Il2CppFuturLab.PW2.TexturePainter.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppFuturLab.PW2.SaveData"><HintPath>$(Il2CppDir)\Il2CppFuturLab.PW2.SaveData.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppFuturLab.PW2.WashGraphics"><HintPath>$(Il2CppDir)\Il2CppFuturLab.PW2.WashGraphics.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Generated IL2CPP proxies: Unity -->
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2CppDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(Il2CppDir)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Il2CppDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Il2CppDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIElementsModule"><HintPath>$(Il2CppDir)\UnityEngine.UIElementsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Il2CppDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Il2CppDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Addressables"><HintPath>$(Il2CppDir)\Unity.Addressables.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(Il2CppDir)\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Localization"><HintPath>$(Il2CppDir)\Unity.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Netcode.Runtime"><HintPath>$(Il2CppDir)\Unity.Netcode.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(Il2CppDir)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(Il2CppDir)\Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(Il2CppDir)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CopyToGameMods" AfterTargets="Build" Condition="'$(CopyToGame)' == 'true' And Exists('$(GameDir)\Mods')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
    <Message Importance="high" Text="Copied $(TargetFileName) -> $(GameDir)\Mods" />
  </Target>

</Project>
