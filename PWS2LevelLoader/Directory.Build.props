<Project>
  <PropertyGroup>
    <!-- Override with: dotnet build -p:GameDir="D:\Games\PowerWash Simulator 2" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\PowerWash Simulator 2</GameDir>
    <MLDir>$(GameDir)\MelonLoader\net6</MLDir>
    <Il2CppDir>$(GameDir)\MelonLoader\Il2CppAssemblies</Il2CppDir>
  </PropertyGroup>
</Project>
